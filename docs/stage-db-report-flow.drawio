<mxfile host="app.diagrams.net"><diagram id="flow" name="Pipeline flow"><mxGraphModel dx="1120" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageWidth="1120" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Stage DB Report — Pipeline Flow&lt;/b&gt;" style="text;html=1;fontSize=22;fontColor=#222222;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="22" width="700" height="28" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b&gt;When SQL changes&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#7F6000;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="250" height="28" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b&gt;Each report run&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#1F4E78;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="78" width="320" height="28" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b&gt;If any step fails&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#B85450;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="800" y="78" width="280" height="28" as="geometry"/></mxCell><mxCell id="grp" value="&lt;b&gt;Jenkins pipeline (Windows agent)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#FAFAFA;strokeColor=#999999;verticalAlign=top;fontSize=12;fontColor=#555555;arcSize=4;" vertex="1" parent="1"><mxGeometry x="400" y="222" width="320" height="465" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="feeds" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;dashed=1;" edge="1" parent="1" source="a2" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="m4" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="m5" target="m6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;" edge="1" parent="1" source="m6" target="m7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ef" value="on failure" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#B85450;fontColor=#B85450;" edge="1" parent="1" source="grp" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;SQL author / DBA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Merges reviewed .sql file to Git (main)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="250" height="74" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;Report dropdown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reads the .sql list from Git live&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="250" height="74" as="geometry"/></mxCell><mxCell id="m1" value="&lt;b&gt;Release team: Build with Parameters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Pick SQL report + enter recipient emails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="320" height="84" as="geometry"/></mxCell><mxCell id="m2" value="&lt;b&gt;1. Validate request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Selection, recipients, mail settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="265" width="280" height="62" as="geometry"/></mxCell><mxCell id="m3" value="&lt;b&gt;2. Fetch SQL from Git&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Exact approved revision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="352" width="280" height="62" as="geometry"/></mxCell><mxCell id="m4" value="&lt;b&gt;3. Run query on Stage DB2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Read-only service account over TLS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="439" width="280" height="62" as="geometry"/></mxCell><mxCell id="m5" value="&lt;b&gt;4. Build Excel workbook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;One sheet per SELECT query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="526" width="280" height="62" as="geometry"/></mxCell><mxCell id="m6" value="&lt;b&gt;5. Email workbook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Sent to the recipients entered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="613" width="280" height="62" as="geometry"/></mxCell><mxCell id="m7" value="&lt;b&gt;Workspace wiped&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;No report data left on the agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="705" width="280" height="50" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Failure email to support DL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;No attachment. Build marked FAILED.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;arcSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="420" width="280" height="100" as="geometry"/></mxCell><mxCell id="t2" value="&lt;b&gt;Build with Parameters — what the release team sees&lt;/b&gt;" style="text;html=1;fontSize=17;fontColor=#222222;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="786" width="700" height="28" as="geometry"/></mxCell><mxCell id="t2b" value="The release team fills in 3 fields on the Jenkins Build with Parameters page." style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="812" width="1040" height="28" as="geometry"/></mxCell><mxCell id="p1" value="PARAMETER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#BBBBBB;fontSize=12;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="862" width="200" height="30" as="geometry"/></mxCell><mxCell id="p2" value="TYPE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#BBBBBB;fontSize=12;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="862" width="230" height="30" as="geometry"/></mxCell><mxCell id="p3" value="OPTIONS / WHAT TO ENTER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F4E78;strokeColor=#BBBBBB;fontSize=12;fontColor=#FFFFFF;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="862" width="610" height="30" as="geometry"/></mxCell><mxCell id="p4" value="SCRIPT_SELECTION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="892" width="200" height="58" as="geometry"/></mxCell><mxCell id="p5" value="Active Choices (dropdown)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="892" width="230" height="58" as="geometry"/></mxCell><mxCell id="p6" value="Every approved .sql file in Git (e.g. daily/case_summary.sql). List is read live from Git; type to search." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="470" y="892" width="610" height="58" as="geometry"/></mxCell><mxCell id="p7" value="STAKEHOLDERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="200" height="58" as="geometry"/></mxCell><mxCell id="p8" value="Text box" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="950" width="230" height="58" as="geometry"/></mxCell><mxCell id="p9" value="Recipient emails separated by , or ; Distribution lists are fine. No display names." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="470" y="950" width="610" height="58" as="geometry"/></mxCell><mxCell id="p10" value="ARCHIVE_REPORT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1008" width="200" height="58" as="geometry"/></mxCell><mxCell id="p11" value="Checkbox" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="240" y="1008" width="230" height="58" as="geometry"/></mxCell><mxCell id="p12" value="Unticked (default): the emailed copy is the only copy. Ticked: Jenkins also keeps the workbook." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#BBBBBB;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="470" y="1008" width="610" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
